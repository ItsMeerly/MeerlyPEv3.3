 local function clickerUpgradeCost(def, level)
     return math.max(1, math.floor((def.baseCost * (def.growth ^ level)) + 0.5))
 end
 
+-- Geometric series sum:
+-- base + base*g + ... for lv terms => base * (g^lv - 1)/(g - 1)
+local function geometricSum(base, g, lv)
+    lv = math.max(0, math.floor(tonumber(lv) or 0))
+    base = tonumber(base) or 0
+    g = tonumber(g) or 1
+    if lv <= 0 then return 0 end
+    if math.abs(g - 1) < 1e-6 then
+        return base * lv
+    end
+    return base * ((g ^ lv) - 1) / (g - 1)
+end
