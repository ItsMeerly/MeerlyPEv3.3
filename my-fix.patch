+    local clickFlat = 1
+    local passiveFlat = 0
+    local clickMult = 1
+    local passiveMult = 1
+
+    for _, def in ipairs(CLICKER_UPGRADES) do
+        local lv = clickerUpgradeLevels[def.id] or 0
+        if lv > 0 then
+            local og = def.outGrowth or 1
+
+            if def.kind == "clickFlat" then
+                clickFlat += geometricSum(def.value, og, lv)
+
+            elseif def.kind == "passiveFlat" then
+                passiveFlat += geometricSum(def.value, og, lv)
+
+            elseif def.kind == "clickMult" then
+                -- Additive bonus series, applied multiplicatively as (1 + bonus)
+                local bonus = geometricSum(def.value, og, lv)
+                clickMult *= (1 + bonus)
+
+            elseif def.kind == "passiveMult" then
+                local bonus = geometricSum(def.value, og, lv)
+                passiveMult *= (1 + bonus)
+            end
+        end
+    end
+
+    clickPower = math.max(1, math.floor((clickFlat * clickMult) + 0.5))
+    passiveIncomePerSec = math.max(0, math.floor((passiveFlat * passiveMult) + 0.5))
 end

