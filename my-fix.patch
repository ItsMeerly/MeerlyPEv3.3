+-- Tier helper (now supports 6 thresholds)
+-- thresholds = { bronze=..., silver=..., gold=..., platinum=..., diamond=..., master=... }
+local function getTierByThreshold(value, thresholds)
+    value = tonumber(value) or 0
+    thresholds = thresholds or {}
+
+    local bronze   = tonumber(thresholds.bronze)   or math.huge
+    local silver   = tonumber(thresholds.silver)   or math.huge
+    local gold     = tonumber(thresholds.gold)     or math.huge
+    local platinum = tonumber(thresholds.platinum) or math.huge
+    local diamond  = tonumber(thresholds.diamond)  or math.huge
+    local master   = tonumber(thresholds.master)   or math.huge
+
+    -- Highest -> lowest
+    if value >= master   then return "Master" end
+    if value >= diamond  then return "Diamond" end
+    if value >= platinum then return "Platinum" end
+    if value >= gold     then return "Gold" end
+    if value >= silver   then return "Silver" end
+    if value >= bronze   then return "Bronze" end
+    return "None"
+end

